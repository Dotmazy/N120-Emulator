{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-qt-mingw",
      "displayName": "windows-qt-mingw (legacy output)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "studio-upgrade",
      "displayName": "studio-upgrade (legacy output)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-upgrade",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (Qt kit from environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{QT_ANDROID_ARM64}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{QT_ANDROID_ARM64}/lib/cmake/Qt6/qt.toolchain.cmake",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "N120_ANDROID_OPENSSL_ROOT": "$env{N120_ANDROID_OPENSSL_ROOT}",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (Qt kit from environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-x86_64",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{QT_ANDROID_X86_64}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{QT_ANDROID_X86_64}/lib/cmake/Qt6/qt.toolchain.cmake",
        "QT_HOST_PATH": "$env{QT_HOST_PATH}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "N120_ANDROID_OPENSSL_ROOT": "$env{N120_ANDROID_OPENSSL_ROOT}",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "windows-qt-mingw",
      "configurePreset": "windows-qt-mingw"
    },
    {
      "name": "studio-upgrade",
      "configurePreset": "studio-upgrade"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": [
        "apk"
      ]
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64",
      "targets": [
        "apk"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-qt-mingw",
      "configurePreset": "windows-qt-mingw",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "studio-upgrade",
      "configurePreset": "studio-upgrade",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
